# Copy this file to .env and fill in what you have. Never commit .env.

# --- PayPal -----------------------------------------------------------------
# mock    = built-in fake PayPal, no keys needed (default, good for the first run)
# sandbox = real PayPal sandbox, needs the three values below
# live    = real money. sandbox_only functions are blocked.
PAYPAL_ENV=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The ID PayPal shows after you create a webhook pointing at /webhooks/paypal
PAYPAL_WEBHOOK_ID=

# --- Claude -----------------------------------------------------------------
# Leave empty to run the agents on the built-in rules engine instead of Claude.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MAX_TOKENS=2000

# --- Governance -------------------------------------------------------------
# money_legal actions at or under this amount run without waiting for approval.
# 0 = every money/legal action waits for a human.
AUTO_APPROVE_CAP=25.00
AUTO_APPROVE_CURRENCY=USD
# Max automatic messages (reminders, dispute messages) per client per hour.
COMMUNICATE_RATE_LIMIT=20

# --- Daemon -----------------------------------------------------------------
AGENTOS_HOST=127.0.0.1
AGENTOS_PORT=8000
# Where the SQLite file lives. Default: ~/.agentos/agentos.db
# (kept outside the project so OneDrive/Dropbox do not fight over the file).
AGENTOS_DB_PATH=
# If set, the dashboard and API need this token (required when deployed publicly).
DASHBOARD_TOKEN=
# Run the collections sweep every N minutes. 0 = only when you trigger it.
COLLECTIONS_SWEEP_MINUTES=0
